<?xml version="1.0" ?>
<xacro:contents xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:property name="body_color" value="Gazebo/Silver" />

<gazebo reference="base_link">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <selfCollide>false</selfCollide>
  <gravity>true</gravity>
</gazebo>

<gazebo reference="paleta_muneca_der_1">
  <material>Gazebo/Grey</material>
  <mu1>2.0</mu1> <mu2>2.0</mu2>
  <kp>1000000.0</kp>
  <kd>1.0</kd>
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="paleta_muneca_izq_1_1">
  <material>Gazebo/Grey</material>
  <mu1>2.0</mu1>
  <mu2>2.0</mu2>
  <kp>1000000.0</kp>
  <kd>1.0</kd>
  <selfCollide>false</selfCollide>
</gazebo>

<gazebo reference="soporte_camara_1_1">
  <sensor name="camera" type="camera">
    <pose>0 0 0 0 0 0</pose>
    <visualize>true</visualize>
    <update_rate>30</update_rate>
    <camera>
      <horizontal_fov>1.089</horizontal_fov>
      <image>
        <format>R8G8B8</format>
        <width>640</width>
        <height>480</height>
      </image>
      <clip>
        <near>0.05</near>
        <far>8.0</far>
      </clip>
    </camera>
    <plugin filename="libignition-gazebo-camera-system.so" name="ignition::gazebo::systems::Camera">
    </plugin>
  </sensor>
</gazebo>

</xacro:contents>
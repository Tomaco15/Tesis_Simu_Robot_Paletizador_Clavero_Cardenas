<?xml version="1.0" ?>
<robot name="bandeja" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:arg name="include_ros_extensions" default="true"/>
<xacro:arg name="mesh_directory" default="package://bandeja_description/meshes"/>
<xacro:property name="mesh_directory" value="$(arg mesh_directory)"/>

<xacro:include filename="materials.xacro" />
<xacro:if value="$(arg include_ros_extensions)">
  <xacro:include filename="bandeja.trans" />
  <xacro:include filename="bandeja.gazebo" />
</xacro:if>
<link name="base_link">
  <inertial>
    <origin xyz="-0.0003670224788962248 -0.00032310327888739027 0.026548007642999714" rpy="0 0 0"/>
    <mass value="0.5306530561152163"/>
    <inertia ixx="0.007973" iyy="0.020537" izz="0.02809" ixy="4.1e-05" iyz="1e-06" ixz="-1.3e-05"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="${mesh_directory}/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="${mesh_directory}/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

</robot>

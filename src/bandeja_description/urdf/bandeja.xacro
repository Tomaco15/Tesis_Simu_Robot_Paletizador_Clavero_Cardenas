<?xml version="1.0"?>
<robot name="bandeja" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="include_gazebo" default="true"/>
  <xacro:arg name="mesh_directory" default="package://bandeja_description/meshes"/>
  <xacro:property name="mesh_directory" value="$(arg mesh_directory)"/>

  <xacro:include filename="materials.xacro"/>
  <xacro:include filename="bandeja.ros2control"/>
  <xacro:if value="$(arg include_gazebo)">
    <xacro:include filename="bandeja.gazebo"/>
  </xacro:if>

  <link name="base_link">
    <inertial>
      <origin xyz="0.2589231849793322 0.15409413662488208 0.01668275201406195" rpy="0 0 0"/>
      <mass value="8.678276715774595"/>
      <inertia ixx="0.098494" iyy="0.246762" izz="0.338976" ixy="-6e-06" iyz="1e-06" ixz="-1e-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_directory}/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_directory}/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

</robot>

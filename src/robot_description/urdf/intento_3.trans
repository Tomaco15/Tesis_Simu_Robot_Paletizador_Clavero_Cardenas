<?xml version="1.0" ?>
<robot name="intento_3" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<transmission name="x_joint_tran">
  <type>transmission_interface/SimpleTransmission</type>
  <joint name="x_joint">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
  </joint>
  <actuator name="x_joint_actr">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    <mechanicalReduction>1</mechanicalReduction>
  </actuator>
</transmission>


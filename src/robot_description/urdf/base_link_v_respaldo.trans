<?xml version="1.0" ?>
<robot name="base_link" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<transmission name="Corredera 3_tran">
  <type>transmission_interface/SimpleTransmission</type>
  <joint name="Eje x">

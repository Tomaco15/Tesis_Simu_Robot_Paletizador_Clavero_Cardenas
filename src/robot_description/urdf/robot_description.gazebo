<?xml version="1.0" ?>
<robot name="robot_description" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<xacro:property name="body_color" value="Gazebo/Silver" />

<gazebo reference="base_link">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
  <gravity>false</gravity>
</gazebo>

<gazebo reference="x_link_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
  <gravity>false</gravity>
</gazebo>

<gazebo reference="y_link_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
  <gravity>false</gravity>
</gazebo>

<gazebo reference="z_link_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
  <gravity>false</gravity>
</gazebo>

<gazebo>
  <!-- x_joint: lower=0.02, upper=0.94 → centro = 0.48 -->
  <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
    <joint_name>x_joint</joint_name>
    <p_gain>10000.0</p_gain>
    <i_gain>0.0</i_gain>
    <d_gain>500.0</d_gain>
    <cmd_max>10000</cmd_max>
    <cmd_min>-10000</cmd_min>
    <initial_position>0.48</initial_position>
  </plugin>
  <!-- y_joint: lower=0.065, upper=0.838 → centro = 0.4515 -->
  <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
    <joint_name>y_joint</joint_name>
    <p_gain>10000.0</p_gain>
    <i_gain>0.0</i_gain>
    <d_gain>500.0</d_gain>
    <cmd_max>10000</cmd_max>
    <cmd_min>-10000</cmd_min>
    <initial_position>0.4515</initial_position>
  </plugin>
  <!-- z_joint: lower=0.0, upper=0.93 → centro = 0.465 -->
  <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
    <joint_name>z_joint</joint_name>
    <p_gain>10000.0</p_gain>
    <i_gain>0.0</i_gain>
    <d_gain>500.0</d_gain>
    <cmd_max>10000</cmd_max>
    <cmd_min>-10000</cmd_min>
    <initial_position>0.465</initial_position>
  </plugin>
</gazebo>

</robot>
